# ---------------------------------------------------------------- verplicht
# web en worker allebei. Op Railway een referentie naar je database service,
# bijvoorbeeld ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://...

# alleen worker. Het enige proces dat Claude aanroept.
ANTHROPIC_API_KEY=sk-ant-...

# alleen web. Zelf genereren met: openssl rand -hex 32
# Dezelfde waarde zet je in Pocket bij de webhook.
POCKET_WEBHOOK_SECRET=

# alleen web. Wie er mag inloggen, gescheiden door komma's. Leeg betekent dat
# niemand binnenkomt — dat is de veilige stand, maar dan sta je zelf ook buiten.
AUTH_ALLOWED_EMAILS=jij@voorbeeld.nl

# ------------------------------------------------------------------ optioneel
# Alles hieronder heeft een werkende standaard. Leeg laten kan.

# worker. Standaard claude-opus-5 op effort high.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# web. Standaard x-pocket-signature.
POCKET_SIGNATURE_HEADER=

# web en worker. Standaard prefer: probeert TLS, valt terug op plat.
# Zet require of verify-full om TLS af te dwingen, disable om het uit te zetten.
DATABASE_SSL=

# ------------------------------------------------------- nog niet in gebruik
# Deze worden door geen enkele regel code gelezen. Ze horen bij latere sprints:
# mail inbound is sprint 4, briefings en magic link login zijn sprint 5.
# POCKET_API_KEY=pk_...
# RESEND_API_KEY=re_...
# MAIL_FROM=hub@mail.jouwdomein.nl
# MAIL_TO=marten@...
# INBOUND_DOMAIN=in.jouwdomein.nl
# APP_URL=https://...
# SESSION_SECRET=

# web. Zonder deze sleutel wordt er geen mail verstuurd en komt de inloglink in
# de serverlog te staan. Handig lokaal, niet de bedoeling in productie.
RESEND_API_KEY=

# web. Afzender van de inlogmail. Standaard het testadres van Resend, dat alleen
# naar je eigen geverifieerde adres mag sturen.
MAIL_FROM=

# web. Basis-URL voor de inloglink, bijvoorbeeld https://jouwapp.up.railway.app.
# Zonder deze probeert hij RAILWAY_PUBLIC_DOMAIN en daarna de proxy-headers.
# Lukt dat allemaal niet, dan wordt er geen mail verstuurd: een link naar
# localhost in je mailbox ziet eruit alsof het werkte.
APP_URL=

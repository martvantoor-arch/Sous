{
  "name": "meetinghub",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @meetinghub/web dev",
    "dev:worker": "pnpm --filter @meetinghub/worker dev",
    "db:generate": "pnpm --filter @meetinghub/db generate",
    "db:migrate": "pnpm --filter @meetinghub/db migrate",
    "db:seed": "pnpm --filter @meetinghub/db seed"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
